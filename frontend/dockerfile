FROM node:22-bookworm-slim

WORKDIR /app/frontend

# Asenna riippuvuudet
COPY frontend/package*.json ./
RUN npm ci

# Kopioi frontendin lähdekoodi imageen
COPY frontend/ ./

EXPOSE 5173
# Kuuntele kontin ulkoisia yhteyksiä, jotta palvelu näkyy host-koneelle
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]