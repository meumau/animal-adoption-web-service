FROM node:22-bookworm-slim

# better-sqlite3 tarvitsee nämä työkalut, jos npm asentaa sen lähdekoodista
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/server-b

# Asenna riippuvuudet
COPY server-b/package*.json ./
RUN npm ci

# Kopioi server B:n lähdekoodi imageen
COPY server-b/ ./

# Dokumentoi palvelun portti ja käynnistä API
EXPOSE 8000
CMD ["node", "server.js"]