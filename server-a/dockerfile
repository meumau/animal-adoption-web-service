FROM node:22-bookworm-slim

# better-sqlite3 tarvitsee nämä työkalut, jos npm asentaa sen lähdekoodista
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/server-a

# Asenna riippuvuudet
COPY server-a/package*.json ./
RUN npm ci

# Kopioi server A:n lähdekoodi imageen
COPY server-a/ ./

# Dokumentoi palvelun portti ja käynnistä API
EXPOSE 3000
CMD ["node", "server.js"]